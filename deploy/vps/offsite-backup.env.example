# Copy to /etc/bowl/offsite-backup.env on the droplet (chmod 600, root:root).
# Create a Space in the same region as the droplet (Toronto -> tor1).
# DigitalOcean: API -> Spaces access keys -> Generate new key.

BOWL_SPACES_ENDPOINT=tor1.digitaloceanspaces.com
BOWL_SPACES_BUCKET=bowl-hockey-backups
BOWL_SPACES_ACCESS_KEY=
BOWL_SPACES_SECRET_KEY=
# Optional prefix inside the bucket (no leading slash)
BOWL_SPACES_PREFIX=bowl-production

# DR without a second region: duplicate prefix inside the same Space (Toronto).
BOWL_SPACES_COPY_PREFIX=bowl-production-dr

# Optional second region (leave empty unless you create a Space in e.g. NYC3).
# BOWL_SPACES_SECONDARY_ENDPOINT=nyc3.digitaloceanspaces.com
# BOWL_SPACES_SECONDARY_BUCKET=bowl-hockey-backups
