# Copy to .env and adjust if needed
# Optional comma-separated extra addresses for admin review alerts (news, AP, hub registrations).
# Defaults to JOIN_LEAGUE_RECIPIENT only when unset.
# ADMIN_ALERT_EMAILS=you@example.com,backup@example.com
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production
# Homepage JSON cache warm on boot (3 leagues × workers can overload SQLite). Enable locally only if desired.
# LEAGUE_JSON_CACHE_WARM_ON_STARTUP=1
# Max concurrent background cache rebuild threads per worker (default 2).
# LEAGUE_JSON_CACHE_MAX_BACKGROUND_JOBS=2
# Shared site DB (news, GM accounts, Discord, BOWL Six). Default: SQLite instance/site_membership.db
# PythonAnywhere MySQL: use %24 for the $ in the database name (e.g. BoiledEgg1974%24bowlsite).
# The app decodes this to BoiledEgg1974$bowlsite automatically. Do not put a raw $ in the URL string.
# SITE_DATABASE_URL=mysql+pymysql://BoiledEgg1974:YOUR_MYSQL_PASSWORD@BoiledEgg1974.mysql.pythonanywhere-services.com/BoiledEgg1974%24bowlsite
# Optional MySQL pool tuning (one shared pool per web worker; default 3 + 5 overflow).
# SITE_MYSQL_POOL_SIZE=3
# SITE_MYSQL_MAX_OVERFLOW=5
# SITE_MYSQL_POOL_TIMEOUT=30
# After creating the DB on PA: python scripts/verify_site_mysql_connection.py
# Then migrate once: python scripts/migrate_site_sqlite_to_mysql.py --dry-run
#                   python scripts/migrate_site_sqlite_to_mysql.py
# Per-league default when using app:create_app (see app/config.py). Multi-site run uses wsgi.py and instance/<slug>.db.
LEAGUE_SLUG=bowl-fantasy
DATABASE_URL=sqlite:///instance/bowl-fantasy.db
# BOWL-Relegation Upper/Lower split (off until season-reset FHM CSVs expose tier league IDs).
# RELEGATION_SPLIT_ACTIVE=1
# SQLite busy lock wait (seconds) for SQLAlchemy connect timeout; default 30. Raise if you still see database is locked under load.
# SQLITE_BUSY_TIMEOUT_SECONDS=45
# Same value must be set on each Discord bot that calls /api/discord/events/* (header X-Discord-Events-Secret).
# Generate e.g. Python: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Defaults to bowluniverse in app/config.py when unset; set explicitly in production.
# DISCORD_EVENTS_SHARED_SECRET=bowluniverse
#
# Unified Discord delivery bot (scripts/league_discord_bot) — one process, all three leagues.
# DISCORD_BOT_TOKEN=
# DISCORD_BOT_NAME=league-discord-bot
# DISCORD_BOT_VERSION=1.0.0
# DISCORD_BOT_POLL_SECONDS=8
# DISCORD_BOT_DELIVERY_DELAY_SECONDS=1.2
# DISCORD_BOT_MAX_MESSAGE_PARTS=4
# DISCORD_BOT_SITE_TIMEOUT_SECONDS=90
# DISCORD_BOT_LEAGUE_BASE_URLS=bowl-historical:https://www.bowlhockey.com/bowl-historical,bowl-fantasy:https://www.bowlhockey.com/bowl-fantasy,bowl-cap:https://www.bowlhockey.com/bowl-cap,bowl-formula:https://www.bowlhockey.com/bowl-formula,bowl-demolition:https://www.bowlhockey.com/bowl-demolition
# Slash commands (one Discord app, all three league servers):
# 1. Set DISCORD_INTERACTIONS_PUBLIC_KEY (Developer Portal → Application → Public Key).
# 2. Set Interactions Endpoint URL to SITE_PUBLIC_BASE_URL + /api/discord/interactions
#    (e.g. https://www.bowlhockey.com/api/discord/interactions) — not a per-league path.
# 3. On each league admin Discord Integration page, set that server's numeric Server ID.
# 4. Run: python -m scripts.league_discord_bot.register_slash_commands
# DISCORD_INTERACTIONS_PUBLIC_KEY=
# Optional if DISCORD_BOT_TOKEN is set (script can look up the app id from the token).
# DISCORD_APPLICATION_ID=
# Optional: DISCORD_GUILD_IDS registers commands immediately in specific servers (skips global).
# Use all league server IDs here for guild-scoped commands, e.g. historical,fantasy,cap.
# DISCORD_GUILD_IDS=111111111111111111,222222222222222222,333333333333333333
# Backward-compatible: DISCORD_GUILD_ID may hold one ID, or a comma-separated list.
# Required on PythonAnywhere in boys-of-winter-hockey-website/.env (web app + Always-on bot).
# Without this, Discord event payloads get no embed link (relative paths are rejected by Discord).
SITE_PUBLIC_BASE_URL=https://www.bowlhockey.com
#
# Join League + site email (SMTP). Required for GM applications and password reset.
# Gmail: use an App Password (Google Account → Security → 2-Step Verification → App passwords).
# Do not use your normal Gmail password. Username must be the full Gmail address.
# JOIN_LEAGUE_RECIPIENT=keenovdecimanus@gmail.com
# MAIL_SMTP_HOST=smtp.gmail.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USE_TLS=1
# MAIL_SMTP_USE_SSL=0
# MAIL_SMTP_USERNAME=your-account@gmail.com
# MAIL_SMTP_PASSWORD=your16charapppassword
# (paste Google's 16-char App Password with or without spaces; spaces are stripped on send)
# MAIL_FROM=your-account@gmail.com
#
# Draft Hub desk: optional OpenAI via TRADE_AI_OPENAI_API_KEY (and TRADE_AI_OPENAI_MODEL).
# Set to 1/true/yes/on to force rules-based suggestions only (no OpenAI), e.g. under load.
# DRAFT_HUB_AI_HEURISTIC_ONLY=1
