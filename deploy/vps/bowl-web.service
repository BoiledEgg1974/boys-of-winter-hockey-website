[Unit]
Description=BOWL combined WSGI (hub + leagues)
After=network.target

[Service]
PermissionsStartOnly=true
User=bowl
Group=bowl
WorkingDirectory=/srv/bowl/app
EnvironmentFile=/srv/bowl/app/.env
Environment=PYTHONPATH=/srv/bowl/app
ExecStart=/srv/bowl/app/.venv/bin/gunicorn \
  --bind 127.0.0.1:8000 \
  --workers 3 \
  --threads 2 \
  --timeout 120 \
  --worker-class gthread \
  --access-logfile - \
  --error-logfile - \
  wsgi:application
ExecStartPost=-/bin/systemctl --no-block start bowl-cache-warm.service
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
