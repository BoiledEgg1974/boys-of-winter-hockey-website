# Copy to scripts/cloudflare.env (gitignored). Create token at:
# Cloudflare Dashboard -> My Profile -> API Tokens -> Create Token
# Permissions for zone bowlhockey.com:
#   Zone / Zone Settings / Edit
#   Zone / DNS / Edit
#   Zone / Cache Rules / Edit   (or Zone / Config / Edit)
#   Zone / WAF / Edit

CLOUDFLARE_API_TOKEN=
# Optional if you already know it; otherwise the script looks up by zone name.
CLOUDFLARE_ZONE_NAME=bowlhockey.com
# Origin IPv4 (DigitalOcean droplet)
BOWL_ORIGIN_IPV4=159.203.6.136
